# Copy to .env and fill in. Never commit .env.

# ---- main CRM database (used by db_connection.py) ----
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGSSLMODE=require              # encrypt every database connection (db_connection.py and the RBAC pool); verify-full for certificate checks

# ---- RBAC: per-user connection (read-only role, row-level security) ----
RBAC_MODE=production           # website login through website_connector.py
COPILOT_DB_HOST=
COPILOT_DB_PORT=5432
COPILOT_DB_NAME=
COPILOT_DB_USER=copilot_app
COPILOT_DB_PASSWORD=
COPILOT_RBAC_SECRET=           # long random string, signs the user identity for the database
RBAC_LOOKUP_USER=              # an active system admin of your organization
RBAC_SHOW_SQL=admins
RBAC_MAX_ROWS=1000
RBAC_STATEMENT_TIMEOUT_MS=20000
RBAC_POOL_MAX=5
RBAC_AUDIT_DIR=logs

# ---- AWS: documents and S3 vector bucket ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
DOCS_BUCKET=
DOCS_PREFIX=
DOCS_INDEX=closemore-docs
VECTOR_BUCKET=
INDEX_NAME=closemore-docs
LEGACY_DOCS_INDEX=closemore-docs
EMBED_MODEL_NAME=
EMBED_DIMENSION=

# ---- models (llama.cpp servers) ----
SQL_RAG_URL=                   # llama-base chat completions URL
SQL_RAG_MODEL=llama-base
BRAIN_URL=                     # llama-finetuned chat completions URL
BRAIN_MODEL=llama-finetuned
LLM_TIMEOUT_S=300
LLM_CONNECT_TIMEOUT_S=10
LLM_CONTEXT_TOKENS=8000
WARM_MODELS=1

# ---- understander, SQL, answers ----
UNDERSTAND_ENABLED=1
UNDERSTAND_ENDPOINT=brain
UNDERSTAND_MAX_TOKENS=200
SQL_MAX_TOKENS=300
SQL_MAX_ROWS=200
TABLE_MAX_ROWS=200
ANSWER_MODEL_ROWS=10
ANSWER_MODEL_COLS=8
SPELL_FIX_ENABLED=1
SPELL_FIX_CANDIDATES=10
FIX_WITH_BRAIN=0
WARM_ENTITY_INDEX=1
GUARD_MODEL_ACTION=block
SAFETY_RECHECK_ENDPOINT=base

# ---- document search ----
RAG_MODE=levels
RAG_STRONG_DISTANCE=0.58
RAG_MAX_DISTANCE=0.75
RAG_JUDGE_ENDPOINT=brain
RAG_JUDGE_ON_ERROR=accept
FALLBACK_ENABLED=1
FALLBACK_ON_EMPTY=0

# ---- conversation and display ----
HISTORY_TURNS=6
HISTORY_FULL_TURNS=3
CHART_MAX_BAR_POINTS=25
CHART_MAX_LINE_POINTS=50
ASSISTANT_NAME=Cleo
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=                  # not needed: only the website backend calls this service
LOG_DIR=logs
SCHEMA_PATH=schema.json

# ---- website integration (see docs/INTEGRATION_GUIDE.md) ----
DOCUMENT_UPLOADS=off           # the website uploads documents
WEBSITE_AUTH_MODE=service      # service | jwt   (only used when RBAC_MODE is not demo)
COPILOT_SERVICE_KEY=           # at least 32 random characters, shared only with the website backend
WEBSITE_JWT_KEY=
WEBSITE_JWT_ALGORITHMS=RS256
WEBSITE_JWT_USER_CLAIM=sub
WEBSITE_JWT_AUDIENCE=
WEBSITE_JWT_ISSUER=
WEBSITE_DOCS_BUCKET=
WEBSITE_DOCS_PREFIX=
